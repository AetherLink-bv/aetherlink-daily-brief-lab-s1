{
  "name": "aetherlink-daily-brief",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Daily Brief session: build a complete private HTML brief, then optionally query one approved Jira source through company Vertex.",
  "scripts": {
    "mini": "tsx src/mini.ts sample/calendar-item.sample.json",
    "brief": "tsx src/main.ts --sample",
    "brief:sample": "tsx src/main.ts --sample",
    "outlook": "tsx src/outlook.ts sample/outlook-email.sample.json",
    "brief:voice": "node --import tsx src/voice.ts",
    "brief:live": "tsx src/live.ts",
    "live:check": "tsx src/live.ts --check",
    "docs:check": "node scripts/check-solo-docs.mjs",
    "eval": "tsx --test test/eval.test.ts",
    "test:mini": "tsx --test test/mini.test.ts",
    "test:render": "tsx --test test/render.test.ts",
    "test:schema": "tsx --test test/schema.test.ts",
    "test:tool": "tsx --test test/tool.test.ts",
    "test:live": "tsx --test test/live.test.ts",
    "test:voice": "tsx --test test/voice.test.ts",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test --test-concurrency=2 test/*.test.ts"
  },
  "engines": { "node": ">=20.12" },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.272",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "@types/node": "^22.0.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "fsevents": false
  }
}
