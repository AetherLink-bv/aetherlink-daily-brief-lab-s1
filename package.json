{
  "name": "aetherlink-daily-brief",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Daily brief agent: reads GitLab, Jira, Confluence and Outlook (or GitHub, Linear and Notion) and writes a Dia-style brief as a self-contained HTML artifact.",
  "scripts": {
    "mini": "tsx src/mini.ts sample/calendar-item.sample.json",
    "brief": "tsx src/main.ts --sample",
    "brief:sample": "tsx src/main.ts --sample",
    "docs:check": "node scripts/check-solo-docs.mjs",
    "eval": "tsx --test test/eval.test.ts",
    "test:mini": "tsx --test test/mini.test.ts",
    "test:render": "tsx --test test/render.test.ts",
    "test:schema": "tsx --test test/schema.test.ts",
    "test:tool": "tsx --test test/tool.test.ts",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test test/*.test.ts"
  },
  "engines": { "node": ">=20" },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.272",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "@types/node": "^22.0.0"
  }
}
